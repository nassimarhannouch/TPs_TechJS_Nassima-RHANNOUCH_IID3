extends layout

block content
  .gradient-bg.min-h-screen.flex.items-center.justify-center.px-4.py-12
    .glass.rounded-2xl.shadow-2xl.w-full.max-w-md.p-8.animate__animated.animate__fadeIn
      .text-center.mb-8
        .bg-gradient-to-r.from-purple-600.to-indigo-600.w-16.h-16.rounded-full.flex.items-center.justify-center.mx-auto.mb-4.shadow-lg
          svg.w-8.h-8.text-white(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z")
        h1.text-3xl.font-bold.text-gray-800.mb-2 Créer un compte
        p.text-gray-600 Rejoignez notre bibliothèque numérique
      
      if error
        .bg-red-50.border-l-4.border-red-500.text-red-700.p-4.rounded-lg.mb-6.animate__animated.animate__shakeX
          .flex.items-center
            svg.w-5.h-5.mr-2(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
              path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd")
            span= error
      
      form(action="/register" method="POST")
        .space-y-5
          div
            label.block.text-sm.font-semibold.text-gray-700.mb-2(for="username")
              | Nom d'utilisateur
            .relative
              .absolute.inset-y-0.left-0.pl-3.flex.items-center.pointer-events-none
                svg.h-5.w-5.text-gray-400(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
                  path(fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd")
              input#username.input-focus.w-full.pl-10.pr-4.py-3.border-2.border-gray-200.rounded-xl.outline-none.transition(
                type="text"
                name="username"
                required
                placeholder="Ex: nassima"
              )
          
          div
            label.block.text-sm.font-semibold.text-gray-700.mb-2(for="email")
              | Adresse email
            .relative
              .absolute.inset-y-0.left-0.pl-3.flex.items-center.pointer-events-none
                svg.h-5.w-5.text-gray-400(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
                  path(d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z")
                  path(d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z")
              input#email.input-focus.w-full.pl-10.pr-4.py-3.border-2.border-gray-200.rounded-xl.outline-none.transition(
                type="email"
                name="email"
                required
                placeholder="votre@email.com"
              )
          
          div
            label.block.text-sm.font-semibold.text-gray-700.mb-2(for="password")
              | Mot de passe
            .relative
              .absolute.inset-y-0.left-0.pl-3.flex.items-center.pointer-events-none
                svg.h-5.w-5.text-gray-400(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
                  path(fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd")
              input#password.input-focus.w-full.pl-10.pr-4.py-3.border-2.border-gray-200.rounded-xl.outline-none.transition(
                type="password"
                name="password"
                required
                placeholder="••••••••"
              )
          
          div
            label.block.text-sm.font-semibold.text-gray-700.mb-2(for="confirmPassword")
              | Confirmer le mot de passe
            .relative
              .absolute.inset-y-0.left-0.pl-3.flex.items-center.pointer-events-none
                svg.h-5.w-5.text-gray-400(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
                  path(fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd")
              input#confirmPassword.input-focus.w-full.pl-10.pr-4.py-3.border-2.border-gray-200.rounded-xl.outline-none.transition(
                type="password"
                name="confirmPassword"
                required
                placeholder="••••••••"
              )
        
        button.btn-primary.w-full.text-white.font-semibold.py-3.px-6.rounded-xl.mt-6.shadow-lg(type="submit") 
          | Créer mon compte
      
      .mt-6.text-center
        p.text-gray-600
          | Déjà membre ? 
          a.text-purple-600.font-semibold.hover_underline.ml-1(href="/login") Se connecter
