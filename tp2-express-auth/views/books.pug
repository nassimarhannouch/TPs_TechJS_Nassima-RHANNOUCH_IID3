extends layout

block content
  .min-h-screen(style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);")
    //- Navbar
    nav.glass.shadow-lg
      .max-w-7xl.mx-auto.px-4.sm_px-6.lg_px-8
        .flex.justify-between.items-center.h-20
          .flex.items-center.space-x-3
            .bg-white.w-12.h-12.rounded-xl.flex.items-center.justify-center.shadow-lg
              svg.w-7.h-7.text-purple-600(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
                path(d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z")
            div
              h1.text-2xl.font-bold.text-gray-800 Ma Bibliothèque
              p.text-sm.text-gray-600 Bienvenue, #{user.username} 👋
          
          button.bg-red-500.text-white.px-6.py-2.rounded-xl.font-semibold.shadow-lg.transition.transform.hover_scale-105(onclick="window.location.href='/logout'")
            .flex.items-center.space-x-2
              svg.w-5.h-5(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
                path(fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd")
              span Déconnexion
    
    //- Content
    .max-w-7xl.mx-auto.px-4.sm_px-6.lg_px-8.py-12
      //- Header Section
      .text-center.mb-12
        h2.text-4xl.font-bold.text-white.mb-4 📚 Collection de Livres
        p.text-purple-100.text-lg Découvrez notre sélection de classiques littéraires
      
      //- Books Grid
      .grid.gap-8(class="sm:grid-cols-2 lg:grid-cols-3")
        each book in books
          .glass.rounded-2xl.p-6.hover-lift.shadow-xl.border-2.border-white.border-opacity-20
            .flex.items-start.justify-between.mb-4
              .bg-gradient-to-br.from-purple-500.to-indigo-600.w-14.h-14.rounded-xl.flex.items-center.justify-center.shadow-lg
                svg.w-8.h-8.text-white(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
                  path(d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z")
              .bg-purple-100.text-purple-700.px-3.py-1.rounded-full.text-xs.font-bold= book.year
            
            h3.text-xl.font-bold.text-gray-800.mb-3.leading-tight= book.title
            
            .space-y-2.mb-4
              .flex.items-center.text-gray-600
                svg.w-5.h-5.mr-2.text-purple-600(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
                  path(fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd")
                span.text-sm.font-medium= book.author
            
            .border-t.border-gray-200.pt-4.mt-4
              .flex.items-center.justify-between
                .flex.items-center.text-purple-600.text-sm.font-semibold
                  svg.w-4.h-4.mr-1(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor")
                    path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd")
                  span Classique
                
                button.bg-purple-600.text-white.px-4.py-2.rounded-lg.text-sm.font-semibold.shadow-md.transition.transform.hover_scale-105 Lire
      
      //- Statistics Section
      .mt-16.glass.rounded-2xl.p-8.shadow-xl
        .text-center
          h3.text-2xl.font-bold.text-gray-800.mb-6 📊 Statistiques
          .grid.gap-6(class="sm:grid-cols-3")
            .bg-white.rounded-xl.p-6.shadow-md
              .text-4xl.font-bold.text-purple-600.mb-2= books.length
              .text-gray-600.font-medium Livres disponibles
            
            .bg-white.rounded-xl.p-6.shadow-md
              .text-4xl.font-bold.text-indigo-600.mb-2 5
              .text-gray-600.font-medium Auteurs
            
            .bg-white.rounded-xl.p-6.shadow-md
              .text-4xl.font-bold.text-pink-600.mb-2 1943-1997
              .text-gray-600.font-medium Période